APP_NAME="Hercas Platform API"
ENABLED_MODULES=["cotizador"]
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
HTTP_TIMEOUT_SECONDS=30

# Copiar del proyecto Supabase. Esta API utiliza la sesión del usuario y RLS.
# Las consultas de negocio conservan RLS y usan el JWT del usuario.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Solo backend: opcional para ENVIAR invitaciones Auth desde el panel.
# Nunca copiar a Next.js ni a una variable NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
AUTH_SITE_URL=http://localhost:3000

# Integración opcional. Conservar los valores del .env existente.
ODOO_URL=
ODOO_DATABASE=
ODOO_API_KEY=
